{
  "name": "codeshrink",
  "version": "0.1.0",
  "description": "Query-aware AST code compression for LLMs. Tree-sitter powered.",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "codeshrink",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TimurRakhmatullin86/codeshrink"
  },
  "keywords": [
    "llm",
    "tree-sitter",
    "code-compression",
    "ast",
    "context-window",
    "developer-tools"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "scripts": {
    "build": "napi build --release --platform",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "bin": {
    "codeshrink": "./cli.mjs"
  }
}
